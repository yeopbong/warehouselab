+
+int SortationSystem::zone_of(int location) const {
+    int row = location / map.cols, col = location % map.cols;
+    return std::min(2, row * 3 / map.rows) * 4 + std::min(3, col * 4 / map.cols);
+}
+
+void SortationSystem::emit_task(const std::string& type, const Task& task, int previous_chute) {
+    business_events.push_back({{"type", type}, {"tick", timestep},
+        {"robot", task.agent_assigned}, {"task", task.task_id},
+        {"parcel", task.parcel_id}, {"destination", task.package_dest},
+        {"goal", task.location}, {"chute", task.assigned_chute},
+        {"previous_chute", previous_chute}, {"recirculating", task.recirc}});
+}
+
+void SortationSystem::record_movement() {
+    for (int k = 0; k < num_of_agents; ++k) {
+        if (actual_movements[k].empty() || actual_movements[k].back() != Action::W) continue;
+        int zone = zone_of(curr_states[k].location);
+        if (task_wait_agents.count(k)) ++service_wait_ticks[zone];
+        else if (!env->goal_locations[k].empty() &&
+                 curr_states[k].location != env->goal_locations[k][0].first)
+            ++traffic_wait_ticks[zone];
+    }
+}
+
+void SortationSystem::record_frame() {
+    if (record_trace) {
+        nlohmann::json positions = nlohmann::json::array();
+        for (const auto& state : curr_states) positions.push_back(state.location);
+        position_frames.push_back(positions);
+    }
+    sorted_curve.push_back({timestep, sorted_parcels, n_recirs, reroutes});
+}
+
+nlohmann::json SortationSystem::research_report() const {
+    nlohmann::json zones = nlohmann::json::array();
+    std::vector<int> chute_counts(12, 0);
+    for (int chute : map.chutes) ++chute_counts[zone_of(chute)];
+    for (int zone = 0; zone < 12; ++zone) {
+        zones.push_back({{"zone",zone}, {"traffic_wait_ticks",traffic_wait_ticks[zone]},
+            {"service_wait_ticks",service_wait_ticks[zone]}, {"closed_chute_ticks",closed_chute_ticks[zone]},
+            {"chutes",chute_counts[zone]},
+            {"traffic_wait_fraction",double(traffic_wait_ticks[zone]) / (num_of_agents * double(timestep))},
+            {"closed_fraction",chute_counts[zone] ? double(closed_chute_ticks[zone]) / (chute_counts[zone] * double(timestep)) : 0.0}});
+    }
+    auto intervals = closure_intervals;
+    for (const auto& item : closed_since) intervals.push_back({item.first, item.second, timestep});
+    long long wait_total = 0, service_total = 0;
+    for (auto n : traffic_wait_ticks) wait_total += n;
+    for (auto n : service_wait_ticks) service_total += n;
+    return {{"runtime_version","rss-1.1-parcel-routing"},
+        {"metrics",{{"throughput",double(sorted_parcels)/timestep},
+            {"sorted",sorted_parcels}, {"recirculated",n_recirs}, {"rerouted",reroutes},
+            {"upstream_task_throughput",double(num_of_task_finish)/timestep},
+            {"traffic_wait_ticks",wait_total}, {"service_wait_ticks",service_total},
+            {"valid",fast_mover_feasible}, {"ticks",timestep}}},
+        {"zone_metrics",zones}, {"trace",{{"positions",position_frames},
+            {"events",business_events}, {"closures",intervals},
+            {"curve",sorted_curve}}}};
+}
